local Plr = Players.LocalPlayer

---====== Helper Function (Roblox Audio) ======---

local function PlaySound(soundId, vol, name, parent)
    local sound = Instance.new("Sound")
    sound.SoundId = soundId
    sound.Volume = vol or 1
    sound.Name = name or "CustomSound"
    sound.Parent = parent or workspace
    sound:Play()
    
    -- Remove automaticamente o som após terminar de tocar para não acumular lixo na memória
    sound.Ended:Connect(function()
        sound:Destroy()
    end)
    
    return sound
end

---====== Lighting RED ======---

local cc = Lighting:FindFirstChild("MainColorCorrection")
if not cc then
    cc = Instance.new("ColorCorrectionEffect")
    cc.Name = "MainColorCorrection"
    cc.Parent = Lighting
end

cc.TintColor = Color3.fromRGB(255, 0, 0)
cc.Contrast = 1

TweenService:Create(cc, TweenInfo.new(1.5), {Contrast = 0}):Play()
TweenService:Create(cc, TweenInfo.new(6), {TintColor = Color3.fromRGB(255, 255, 255)}):Play()

