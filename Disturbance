---====== Callbacks ======---

entity:SetCallback("OnSpawned", function()
    print("[RIPPER] Spawned")
end)

entity:SetCallback("OnStartMoving", function()
    print("[RIPPER] Moving")
    -- Substitua "rbxassetid://SEU_ID_AQUI" pelo ID de áudio do Roblox desejado para o movimento
    PlaySound("rbxassetid://0", 10, "rippermoving", workspace)
end)

entity:SetCallback("OnDamagePlayer", function(newHealth)
    if newHealth <= 0 then
        if ReSt:FindFirstChild("GameStats") then
            local stats = ReSt.GameStats:FindFirstChild("Player_"..Plr.Name)
            if stats then
                stats.Total.DeathCause.Value = "Ripper"
            end
        end
        
        -- Para o som de movimento se existir
        local movingSound = workspace:FindFirstChild("rippermoving")
        if movingSound then
            movingSound:Stop()
        end
        
        -- Remove a entidade se existir
        local ripperModel = workspace:FindFirstChild("Ripper")
        if ripperModel then
            ripperModel:Destroy()
        end

        local character = Plr.Character
        if character and character:FindFirstChild("Humanoid") then
            local humanoid = character.Humanoid
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Physics, false)
            if character:FindFirstChild("HumanoidRootPart") then
                character.HumanoidRootPart.Anchored = true
            end
        end

        -- Sons de Jumpscare (Substitua pelos IDs do Roblox se necessário)
        PlaySound("rbxassetid://0", 1, "Ripper5Sound", workspace)
        task.wait(1.5)
        PlaySound("rbxassetid://0", 1, "Ripper6Sound", workspace)

        -- Efeitos visuais na UI
        local playerGui = Plr:FindFirstChild("PlayerGui")
        if playerGui and playerGui:FindFirstChild("MainUI") and playerGui.MainUI:FindFirstChild("Drip") then
            local drip = playerGui.MainUI.Drip
            drip.Image = "rbxassetid://236542974"
            
            drip.Visible = true
            task.wait(0.3)
            drip.Visible = false
            task.wait(0.1)
            drip.Visible = true
            task.wait(0.2)
            drip.Visible = true
            task.wait(0.2)
            drip.Visible = false
            task.wait(0.3)
            drip.Visible = true
            task.wait(0.2)
            drip.Visible = false
        end

        if character and character:FindFirstChild("Humanoid") then
            character.Humanoid.Health = 0
        end

        if ReSt:FindFirstChild("GameStats") and ReSt.GameStats:FindFirstChild("Player_"..Plr.Name) then
            ReSt.GameStats["Player_"..Plr.Name].Total.DeathCause.Value = "Ripper"
        end
    end
end)

entity:SetCallback("OnDespawned", function()
    print("[RIPPER] Despawned")
    
    local success, achievementGiver = pcall(function()
        return loadstring(game:HttpGet("https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Doors/Custom%20Achievements/Source.lua"))()
    end)
    
    if success and achievementGiver then
        achievementGiver({
            Title = "Torn Apart",
            Desc = "Dont leave too early..",
            Reason = "Encounter Ripper.",
            Image = "rbxassetid://17702317077"
        })
    end
end)

